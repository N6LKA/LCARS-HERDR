# Copy to .env, then chmod 600 .env. Never commit .env. (install.sh does this for you.)

# An optional access code for programs running on THIS machine (scripts, tests). It is never accepted from the network.
# People sign in with an account instead; the first account is created on the first visit to the login page.
LCARS_TOKEN=change-me-to-a-long-random-string

# Where to listen. Use 127.0.0.1 if a reverse proxy on this machine is the only thing that should reach it.
HOST=0.0.0.0
PORT=7842

# Behind a reverse proxy (Nginx Proxy Manager, Caddy, Traefik...): list the proxy's address here so failed-login limits
# count the real visitor and not the proxy. Comma separated. Leave unset when browsers connect directly.
# LCARS_TRUSTED_PROXIES=192.0.2.10

# Optional: a file of KEY=value lines (readable only by you) for agents that sign in with an API key.
# Default: ~/.config/lcars/agents.env
# LCARS_AGENT_ENV=/home/you/.config/lcars/agents.env

# Optional: where accounts are kept (default: auth.json next to the app).
# LCARS_AUTH_FILE=/var/lib/lcars/auth.json
