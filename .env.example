# Copy to .env and fill in your values
ANTHROPIC_API_KEY=your-api-key-here

# Optional: path to Claude Code config (auto-discovers MCP servers)
# Defaults to ~/.claude.json
CLAUDE_CONFIG_PATH=~/.claude.json

# Optional: port to run on (default 7842)
PORT=7842

# Optional: host to bind to (default 0.0.0.0)
HOST=0.0.0.0
