# Copy to .env, then chmod 600 .env. Never commit .env.
LCARS_TOKEN=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=7842

# Behind a proxy that has already signed people in (for example Nginx Proxy Manager with Authelia),
# trust its address and the host names it serves. Nothing is trusted unless both are set.
# LCARS_TRUSTED_PROXIES=192.168.1.10
# LCARS_PROXY_HOSTS=lcars.example.com

# Optional: a file of KEY=value lines (readable only by root) for agents that sign in with an API key.
# LCARS_AGENT_ENV=/root/.config/lcars-claude/agents.env
